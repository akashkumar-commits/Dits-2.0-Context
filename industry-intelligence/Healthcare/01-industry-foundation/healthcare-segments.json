      "common_audiences": ["service_users", "caregivers", "therapists", "counselors", "clinical_staff", "administrators"],
      "possible_business_goals": ["service_discovery", "appropriate_access", "appointment_requests", "continuity_of_support", "trust_and_clarity"],
