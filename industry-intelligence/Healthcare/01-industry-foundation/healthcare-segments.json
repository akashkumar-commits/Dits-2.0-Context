      "definition": "Organizations delivering or coordinating healthcare services through remote communication or digital channels.",
      "common_audiences": ["patients", "caregivers", "clinicians", "care_coordinators", "administrative_staff"],
      "possible_business_goals": ["remote_service_access", "appointment_conversion", "geographic_reach", "care_continuity", "administrative_efficiency"],
