    {
      "id": "medical-devices",
      "name": "Medical Devices and Diagnostics Technology",
      "definition": "Organizations developing, manufacturing, distributing, maintaining, or supporting medical devices, diagnostic equipment, and related technology.",
      "common_audiences": ["clinicians", "laboratory_staff", "procurement_teams", "distributors", "service_engineers", "quality_teams", "patients_where_applicable"],
