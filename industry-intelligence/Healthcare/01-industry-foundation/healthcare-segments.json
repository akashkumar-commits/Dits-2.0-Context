
{
  "schema_version": "1.0",
  "package_version": "0.1.0",
  "industry": "healthcare",
  "segments": [
    {
      "id": "hospitals-clinics",
      "name": "Hospitals and Clinics",
      "definition": "Organizations providing in-person healthcare services through facilities, clinicians, departments, or coordinated care teams.",
      "common_audiences": ["patients", "caregivers", "clinicians", "administrative_staff", "referring_providers"],
      "possible_business_goals": ["service_discovery", "appointment_access", "patient_communication", "operational_efficiency", "referral_management"],
      "possible_website_capabilities": ["service_directory", "specialty_pages", "provider_profiles", "location_directory", "appointment_requests", "patient_instructions", "secure_portal"],
      "possible_workflows": ["service_discovery_to_booking", "referral_to_consultation", "appointment_to_follow_up"],
      "possible_integrations": ["scheduling_system", "EHR_EMR", "patient_portal", "CRM", "payment_system"],
      "discovery_questions": ["Which services and specialties are offered?", "Who is eligible to book?", "Is booking a request or a confirmed appointment?", "Which system owns the schedule?", "Which locations and jurisdictions are served?"],
      "do_not_assume": ["All specialties are available at every location", "Website bookings are confirmed automatically", "All visitors are patients", "The organization accepts every insurance plan"],
      "risk_flags": ["patient_data", "clinical_information", "appointment_integrity", "provider_credential_claims"],
      "classification_cues": ["hospital", "clinic", "medical center", "outpatient care", "specialty practice"]
    },
    {
      "id": "diagnostic-labs",
      "name": "Diagnostic Laboratories",
      "definition": "Organizations performing or coordinating diagnostic testing, sample processing, or laboratory services.",
      "common_audiences": ["patients", "clinicians", "laboratory_staff", "referring_organizations", "institutional_customers"],
      "possible_business_goals": ["test_discovery", "sample_collection_coordination", "service_requests", "result_access", "quality_visibility"],
      "possible_website_capabilities": ["test_catalog", "preparation_guidance", "collection_locations", "booking_requests", "institutional_services", "authorized_result_access"],
      "possible_workflows": ["test_request_to_collection", "specimen_receipt_to_result_authorization", "institutional_order_to_reporting"],
      "possible_integrations": ["LIS", "EHR_EMR", "scheduling_system", "identity_provider", "messaging_service"],
      "discovery_questions": ["Which tests are offered?", "Who can order each test?", "How are samples collected and transported?", "Who authorizes results?", "How are results securely delivered?", "Which quality standards and accreditations are verified?"],
      "do_not_assume": ["Every test is available for direct patient booking", "Turnaround times are identical for all tests", "A website should display results without authorization", "The laboratory holds an unverified accreditation"],
