  "classification_rules": [
    {
      "id": "REQ-001",
      "rule": "A statement describing a desired business outcome is not automatically a functional requirement.",
      "action": "Identify the outcome first, then derive and validate candidate requirements."
    },
    {
      "id": "REQ-002",
      "rule": "A suggested feature is not automatically approved scope.",
      "action": "Mark it proposed until the authorized stakeholder approves it."
    },
    {
      "id": "REQ-003",
      "rule": "A requirement must be specific enough to verify.",
      "action": "Add acceptance criteria or record the verification gap."
    },
    {
      "id": "REQ-004",
      "rule": "Existing functionality explicitly marked for preservation must be inventoried and validated.",
      "action": "Create a preservation requirement linked to observed behavior and regression tests."
    },
    {
      "id": "REQ-005",
      "rule": "Nonfunctional requirements require context-specific targets.",
      "action": "Discover relevant performance, availability, accessibility, security, and maintainability expectations without inventing targets."
    },
    {
      "id": "REQ-006",
      "rule": "Conflicting requirements must be recorded as conflicts.",
      "action": "Identify affected stakeholders, impact, and required decision authority."
    }
  ],
